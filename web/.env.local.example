# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service role key (Supabase → Project Settings → API). SOLO servidor: nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Firma de sesiones. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change_me_to_a_long_random_string

# Contraseña del panel /super-admin
SUPER_ADMIN_PASSWORD=change_me

# Opcional: secreto para que un cron llame a /api/sync/live con "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Opcional: cliente que usa el widget cuando el embed no trae client-id
DEFAULT_WIDGET_CLIENT_ID=

# URL pública de la app (para armar URLs absolutas de escudos)
NEXT_PUBLIC_APP_URL=https://widget-futbol-muove.vercel.app

# API-Football (api-sports.io) API Key
API_FOOTBALL_KEY=your_api_football_key
